{
  "name": "web-pigcoder",
  "private": true,
  "description": "Pigcode 官网静态页面，Tailwind 预编译产物输出到 pages/tailwind.css",
  "scripts": {
    "build:css": "tailwindcss -i tailwind.input.css -o pages/tailwind.css --minify",
    "watch:css": "tailwindcss -i tailwind.input.css -o pages/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^3.4.19"
  }
}
